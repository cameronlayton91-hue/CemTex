<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>News Monitor</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #1f2937;
    }

    header {
      background: #111827;
      color: white;
      padding: 30px;
      text-align: center;
    }

    header h1 {
      font-size: 32px;
      margin-bottom: 8px;
    }

    header p {
      color: #cbd5e1;
    }

    .container {
      width: 90%;
      max-width: 1000px;
      margin: 30px auto;
    }

    .search-box {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 25px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .search-box h2 {
      margin-bottom: 15px;
    }

    .input-row {
      display: flex;
      gap: 10px;
    }

    input {
      flex: 1;
      padding: 12px;
      font-size: 16px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
    }

    button {
      padding: 12px 18px;
      border: none;
      border-radius: 7px;
      background: #2563eb;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #1d4ed8;
    }

    .keywords {
      margin-top: 15px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .keyword {
      background: #e0e7ff;
      color: #3730a3;
      padding: 7px 12px;
      border-radius: 20px;
      font-size: 14px;
      cursor: pointer;
    }

    .results-title {
      margin-bottom: 15px;
    }

    .article {
      background: white;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 15px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .article h3 {
      margin-bottom: 8px;
    }

    .article p {
      color: #4b5563;
      line-height: 1.5;
      margin-bottom: 10px;
    }

    .article-meta {
      font-size: 13px;
      color: #6b7280;
    }

    .tag {
      display: inline-block;
      margin-top: 10px;
      background: #dcfce7;
      color: #166534;
      padding: 5px 9px;
      border-radius: 15px;
      font-size: 12px;
    }
  </style>
</head>

<body>

<header>
  <h1>News Monitor</h1>
  <p>Track the internet for news that matters to you.</p>
</header>

<div class="container">

  <div class="search-box">

    <h2>Keywords</h2>

    <div class="input-row">
      <input
        id="keywordInput"
        type="text"
        placeholder="Example: data centers"
      >

      <button onclick="addKeyword()">
        Add Keyword
      </button>
    </div>

    <div class="keywords" id="keywordList"></div>

  </div>


  <h2 class="results-title">
    Latest Matches
  </h2>

  <div id="articles">

    <div class="article">
      <h3>Data Center Construction Continues Rapid Growth</h3>

      <p>
        Demand for new data center infrastructure continues to increase,
        creating opportunities for cooling equipment, hoses, fittings
        and industrial suppliers.
      </p>

      <div class="article-meta">
        Example News Source • Today
      </div>

      <span class="tag">
        Data Centers
      </span>

    </div>


    <div class="article">
      <h3>Industrial Cooling Market Expands</h3>

      <p>
        New cooling technologies are being deployed as computing
        facilities require increasingly powerful thermal management systems.
      </p>

      <div class="article-meta">
        Example Industry Publication • Today
      </div>

      <span class="tag">
        Cooling Systems
      </span>

    </div>

  </div>

</div>


<script>

  let keywords = [
    "Data Centers",
    "Industrial Hose",
    "Cooling Systems"
  ];


  function displayKeywords() {

    const keywordList =
      document.getElementById("keywordList");

    keywordList.innerHTML = "";


    keywords.forEach(function(keyword, index) {

      const tag =
        document.createElement("span");

      tag.className = "keyword";

      tag.innerText =
        keyword + " ×";

      tag.onclick =
        function() {

          keywords.splice(index, 1);

          displayKeywords();

        };

      keywordList.appendChild(tag);

    });

  }


  function addKeyword() {

    const input =
      document.getElementById("keywordInput");

    const keyword =
      input.value.trim();


    if (keyword !== "") {

      keywords.push(keyword);

      input.value = "";

      displayKeywords();

    }

  }


  document
    .getElementById("keywordInput")
    .addEventListener(
      "keypress",
      function(event) {

        if (event.key === "Enter") {
          addKeyword();
        }

      }
    );


  displayKeywords();

</script>


</body>
</html>
